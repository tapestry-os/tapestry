#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "../protos/WarehouseAMR.proto"

WorldInfo {
  info [
    "Scene 1 -- Decentralized task allocation without a cloud."
    "Eight AMRs are staged in a tight block at the dock and settle into"
    "pick zones."
    "Each robot derives its own zone from scr_get_task_slot() over its"
    "own L4 world model. No coordinator, no cloud, no assignment"
    "message -- see ../scene1-zone-allocation.choreo.toml."
  ]
  title "Tapestry warehouse -- scene 1: decentralized zone allocation (N=8)"
  # 16 ms rather than the drone example's 8 ms: a ground vehicle at 0.9 m/s
  # needs nothing like a rotorcraft's attitude-loop rate, and halving the
  # step count matters with 8 controller processes plus a supervisor sharing
  # one machine. The L4-L7 coordination cadence is unaffected either way --
  # main.c accumulates sim time to WM_CYCLE_MS (100 ms) independently.
  basicTimeStep 16
  contactProperties [
    # The AMR's fore/aft casters (contactMaterial "caster" in
    # ../protos/WarehouseAMR.proto) must not scrub against the floor, or the
    # robot veers under a pure-rotation command instead of turning in place.
    ContactProperties {
      material1 "caster"
      material2 "default"
      coulombFriction [ 0 ]
    }
  ]
}
Viewpoint {
  # Top view, looking straight down over the center of the floor. 35 m
  # comfortably fits the full 24x24 m floor (racking pushes the y-extent to
  # ~24.2 m) under Webots' default 45-degree field of view, with margin.
  orientation 0.577 -0.577 -0.577 4.19
  position 0 0 35
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 24.0 24.0
  tileSize 7 7
}

Solid {
  translation -11.8 0 0.6
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.42 0.38
        roughness 0.9
        metalness 0
      }
      geometry Box {
        size 0.4 22 1.2
      }
    }
  ]
  name "dock wall"
  boundingObject Box {
    size 0.4 22 1.2
  }
}

Solid {
  translation 0 11.5 1.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.28 0.3 0.34
        roughness 0.85
        metalness 0.6
      }
      geometry Box {
        size 22 1.0 2.5
      }
    }
  ]
  name "racking north"
  boundingObject Box {
    size 22 1.0 2.5
  }
}

Solid {
  translation 0 -11.5 1.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.28 0.3 0.34
        roughness 0.85
        metalness 0.6
      }
      geometry Box {
        size 22 1.0 2.5
      }
    }
  ]
  name "racking south"
  boundingObject Box {
    size 22 1.0 2.5
  }
}


# -- Pick stations ----------------------------------------------------------
# Purely cosmetic set dressing -- a small box stack at each of the 9
# FORM/GRID cells (scene1-zone-allocation.choreo.toml: target=[0,0,0],
# shape="grid", radius=3.5 -- bse.c's GRID math gives the same 3x3 centers
# these use). Offset 1.0 m into the upper-right (north-east) quadrant of
# each cell's own territory, not the cell center itself -- the first
# version sat 0.8 m north of center and robots drove straight through it
# (no boundingObject, so nothing stopped them, and it looked wrong even
# without physics). North-east was empirically clear of every robot's
# travel path in the run this was checked against; re-verify if the
# fleet's paths ever change. Sized 2x the original (0.8x0.8x0.6 base box)
# for visibility, with a third, smaller box added on top for a fuller
# stack. No boundingObject (nothing for a robot to physically collide
# with -- these are not part of the simulation the robots' own scripted
# targets know about) and no controller (unlike "warehouse supervisor"
# below, these are not even a Robot node, so there is no ambiguity about
# authority: a plain Solid cannot read as one).

Solid {
  translation -2.5 -2.5 0.0
  children [
    Solid {
      translation 0 0 0.3
      children [ Shape {
        appearance PBRAppearance { baseColor 0.55 0.4 0.25 roughness 0.9 metalness 0 }
        geometry Box { size 0.8 0.8 0.6 }
      } ]
      name "station 0 crate"
    }
    Solid {
      translation 0.12 0.08 0.82
      children [ Shape {
        appearance PBRAppearance { baseColor 0.62 0.46 0.3 roughness 0.9 metalness 0 }
        geometry Box { size 0.52 0.52 0.44 }
      } ]
      name "station 0 box"
    }
    Solid {
      translation -0.08 0.1 1.19
      children [ Shape {
        appearance PBRAppearance { baseColor 0.68 0.52 0.34 roughness 0.9 metalness 0 }
        geometry Box { size 0.36 0.36 0.3 }
      } ]
      name "station 0 lid"
    }
  ]
  name "station 0"
}
Solid {
  translation 1 -2.5 0.0
  children [
    Solid {
      translation 0 0 0.3
      children [ Shape {
        appearance PBRAppearance { baseColor 0.55 0.4 0.25 roughness 0.9 metalness 0 }
        geometry Box { size 0.8 0.8 0.6 }
      } ]
      name "station 1 crate"
    }
    Solid {
