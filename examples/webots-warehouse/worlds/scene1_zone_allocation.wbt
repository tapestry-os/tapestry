# -- The fleet ------------------------------------------------------------
# controllerArgs: <element_id> <n_elements> <scene> [fail_at_s] -- read by
# controllers/rover/main.c, and by the transceiver's per-element UDP port
# fan-out. n_elements and scene must match across every node in this file.
#
# Staging is per-scene and deliberate; see the generator note in the README.

WarehouseAMR {
  translation -10.90 -1.65 0.08
  rotation 0 0 1 0
  name "amr0"
  controllerArgs [ "0" "8" "1" ]
}

WarehouseAMR {
  translation -10.90 -0.55 0.08
  rotation 0 0 1 0
  name "amr1"
  controllerArgs [ "1" "8" "1" ]
}

WarehouseAMR {
  translation -10.90 0.55 0.08
  rotation 0 0 1 0
  name "amr2"
  controllerArgs [ "2" "8" "1" ]
}

WarehouseAMR {
  translation -10.90 1.65 0.08
  rotation 0 0 1 0
  name "amr3"
  controllerArgs [ "3" "8" "1" ]
}

WarehouseAMR {
  translation -9.80 -1.65 0.08
  rotation 0 0 1 0
  name "amr4"
  controllerArgs [ "4" "8" "1" ]
}

WarehouseAMR {
  translation -9.80 -0.55 0.08
  rotation 0 0 1 0
  name "amr5"
  controllerArgs [ "5" "8" "1" ]
}

WarehouseAMR {
  translation -9.80 0.55 0.08
  rotation 0 0 1 0
  name "amr6"
  controllerArgs [ "6" "8" "1" ]
}

WarehouseAMR {
  translation -9.80 1.65 0.08
  rotation 0 0 1 0
  name "amr7"
  controllerArgs [ "7" "8" "1" ]
}

# Presentation only -- reads each element's status datagrams and paints
# on-screen labels. It has NO authority: it never writes to a robot, never
# relays between them, and nothing in L3-L7 reads it. See
# controllers/rover/status_tx.h.
Robot {
  name "warehouse supervisor"
  controller "warehouse_supervisor"
  supervisor TRUE
}
