mainmenu "Tapestry cf21bl-formation"

source "Kconfig.zephyr"
rsource "../../tapestry-os/boards/crazyflie21bl/Kconfig"
rsource "../../tapestry-os/subsys/runtime/Kconfig"
rsource "../../tapestry-os/subsys/transport/Kconfig"

config TAPESTRY_ELEMENT_ID
	int "Element ID [0..4]"
	range 0 4
	default 0
	help
	  Unique identity for this drone.  Override at build time:
	    west build ... -- -DCONFIG_TAPESTRY_ELEMENT_ID=1

config TAPESTRY_ELEMENT_COUNT
	int "Number of drones in the formation"
	range 2 5
	default 3
	help
	  Sets n_total for the formation demo.  The sync window waits until
	  (n_total - 1) peers are fresh before arming and flying.
	    2 drones: -DCONFIG_TAPESTRY_ELEMENT_COUNT=2
	    3 drones: -DCONFIG_TAPESTRY_ELEMENT_COUNT=3  (default)

config TAPESTRY_QUORUM_MIN
	int "Minimum fresh peers for DEGRADED state"
	range 0 4
	default 1

config TAPESTRY_QUORUM_TARGET
	int "Minimum fresh peers for HEALTHY state"
	range 0 4
	default 1
