mainmenu "Tapestry cf21bl-formation"

source "Kconfig.zephyr"
rsource "../../tapestry-os/boards/crazyflie21bl/Kconfig"
rsource "../../tapestry-os/subsys/runtime/Kconfig"
rsource "../../tapestry-os/subsys/transport/Kconfig"

choice DEMO_MODE
	prompt "Demo mode"
	default DEMO_MODE_CHOREO

config DEMO_MODE_CHOREO
	bool "Choreo script (L6/L7): hold stations, exchange places, rest"
	help
	  The drones execute a declarative L7 Choreo script through the L6
	  BSE.  The script is authored in choreo.toml (this directory) and
	  compiled to src/choreo_script.h by sdk/tools/choreoc.py — edit the
	  TOML, re-run the tool, rebuild.  Default show: hold stations,
	  exchange places (stations rotate via the BSE's arc maneuver), bow,
	  then rest — script completion maps to landing in place.

	  ONE BINARY for all drones: element IDs are negotiated at boot over
	  the radio (transport_negotiate_id — same auto-ID protocol as
	  cutebot-formation), so no per-drone build flags are needed.

config DEMO_MODE_SHOWCASE
	bool "Legacy showcase (L4 spring field, per-drone builds)"
	help
	  The flight-validated 2026-07 showcase: spring-field formation with
	  phase choreography keyed off fresh-peer count (line → rotating
	  triangle → member departs → line).  Uses per-drone build flags
	  (TAPESTRY_ELEMENT_ID, DEMO_START_DELAY_S, DEMO_MISSION_DURATION_S,
	  DEMO_HOLD_STATION).

endchoice

config DEMO_ALLOW_SOLO
	bool "Choreo: allow arming with no peers heard (n_total=1)"
	depends on DEMO_MODE_CHOREO
	default n
	help
	  By default a drone whose auto-ID window heard NO peers refuses to
	  arm and becomes a grounded radio-diagnostic station (a swap needs
	  two drones, and flying solo after failed negotiation is how
	  duplicate-ID flights happen).  Enable only for deliberate
	  single-drone testing of the choreo stack.

config TAPESTRY_ELEMENT_ID
	int "Element ID [0..4] (showcase mode only)"
	range 0 4
	default 0
	help
	  Unique identity for this drone in showcase mode.  Choreo mode
	  ignores this and negotiates IDs at boot.  Override at build time:
	    west build ... -- -DCONFIG_TAPESTRY_ELEMENT_ID=1

config TAPESTRY_ELEMENT_COUNT
	int "Number of drones in the formation (showcase mode only)"
	range 2 5
	default 3
	help
	  Sets n_total for the showcase demo.  Choreo mode ignores this and
	  takes the count from auto-ID negotiation.  The sync window waits
	  until (n_total - 1) peers are fresh before arming and flying.
	    2 drones: -DCONFIG_TAPESTRY_ELEMENT_COUNT=2
	    3 drones: -DCONFIG_TAPESTRY_ELEMENT_COUNT=3  (default)

config DEMO_MISSION_DURATION_S
	int "Seconds from arming until this drone lands itself"
	depends on DEMO_MODE_SHOWCASE
	range 10 600
	default 60
	help
	  Per-drone mission length.  Give one drone a shorter duration to
	  choreograph an early departure (it lands, goes gossip-silent, and
	  the survivors re-form without it):
	    west build ... -- -DCONFIG_DEMO_MISSION_DURATION_S=30

config DEMO_START_DELAY_S
	int "Ground hold before the arming countdown (staggered join)"
	depends on DEMO_MODE_SHOWCASE
	range 0 300
	default 0
	help
	  Extra seconds this drone waits on the ground (after lighthouse fix,
	  before the arming countdown, not yet gossiping) so it can visibly
	  join an already-flying formation:
	    west build ... -- -DCONFIG_DEMO_START_DELAY_S=15

config DEMO_HOLD_STATION
	bool "Pinned member: hold the seeded position, ignore formation forces"
	depends on DEMO_MODE_SHOWCASE
	default n
	help
	  This drone holds station at its first-fix seed for the whole
	  mission.  It still gossips, so peers keep their spacing from it
	  and the formation forms AROUND it; it still runs the full safety
	  layer (geofence, fix-loss, separation warning).  Useful for a
	  mechanically weak airframe whose trim converges well against a
	  static setpoint but is continuously re-excited by a moving one:
	    west build ... -- -DCONFIG_DEMO_HOLD_STATION=y

config DEMO_MISSION_MARGIN_S
	int "Choreo: backstop margin added to the script's own time bound"
	depends on DEMO_MODE_CHOREO
	range 20 600
	default 90
	help
	  The mission-duration backstop is CHOREO_SCRIPT_TOTAL_TIMEOUT_MS
	  plus this margin, counted from the end of the convergence hold.

	  Sizing it is NOT just ramp + descent.  Script step timers FREEZE
	  while the Choreo is SUSPENDED (quorum lost), so a script's
	  wall-clock runtime exceeds its own time bound by however long the
	  link was down.  On a marginal P2P link that is most of the flight:
	  the 48 s change-partners script has taken >90 s of wall clock at
	  ~15% gossip delivery.  The old 40 s margin left the script racing
	  its own backstop, and a flight that lands on the backstop instead
	  of on script completion looks identical from the ground while
	  meaning something completely different (2026-08-24 flight 16).

	  Raise this when chasing script behavior on a poor link; lower it
	  for a tight safety envelope on a good one.

config DEMO_CONSOLE_VERBOSE
	bool "Verbose console (per-tick tracking debug + lighthouse info)"
	default n
	help
	  Deep single-drone debugging: formation.c's tracking traces at the
	  full per-tick rate (10 Hz instead of the throttled ~1 Hz) and the
	  lighthouse driver's per-fix info lines.

	  Leave this OFF for multi-drone flights.  Every drone shares one
	  CRTP console address, and read_console.py has a single line buffer
	  with no source discrimination, so the two drones' output splices
	  together mid-line: at the default levels ~34 lines/s combined
	  destroyed most of the 1 Hz formation status lines — including the
	  landing lines — in flights 15 and 16.  Off, the same flight emits
	  roughly a third of that and the status timeline survives.

config CF21BL_LH2_LOG_LEVEL
	int
	default 3 if DEMO_CONSOLE_VERBOSE
	default 2

config TAPESTRY_QUORUM_MIN
	int "Minimum fresh peers for DEGRADED state"
	range 0 4
	default 1

config TAPESTRY_QUORUM_TARGET
	int "Minimum fresh peers for HEALTHY state"
	range 0 4
	default 1
