# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# build info
build/
__pycache__/
*.pyc

# Python tooling caches (pytest and ruff write these wherever they run)
.pytest_cache/
.ruff_cache/
wifi.conf

# west workspace metadata (created by west init one level above the repo)
.west/

# Python virtual environment (if created inside the repo)
.venv/

# byproducts
tmp/
*.csv
*.png

# ...except the committed replay fixture: choreo_sim --replay needs a
# recording to run against, and this one is checked in so CI can exercise
# the replay path without Webots or a captured flight.  Regenerate with
# `python3 sdk/tests/helpers.py`.
!sdk/tests/data/*.csv

# Webots: per-user project-state cache and the compiled controller binary
# (Makefile.include names it after the controller directory, no extension)
*.wbproj
examples/webots-formation/controllers/cf21bl/cf21bl

# ci-check/ (header-stub compile check, no Webots install — see that dir)
examples/webots-formation/ci-check/build/
