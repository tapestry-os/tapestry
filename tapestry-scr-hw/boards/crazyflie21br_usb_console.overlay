/*
 * crazyflie21br_usb_console.overlay — USB CDC ACM console retry
 *
 * Switches the Zephyr console/shell from the (now-confirmed-working) wired
 * USART3 to USB CDC ACM over the STM32F405's OTG_FS peripheral on PA11/PA12.
 *
 * Pin assignment (PA11=DM, PA12=DP, AF10) confirmed from the stock Bitcraze
 * firmware's USB_OTG_BSP_Init() (crazyflie-firmware/src/hal/src/usb_bsp.c) —
 * VBUS sensing is intentionally NOT wired (matches stock firmware, which
 * leaves the VBUS GPIO_InitStructure commented out); omitting
 * usb_otg_fs_vbus_pa9 from pinctrl-0 makes the Zephyr STM32 USB driver
 * disable VBUS sensing automatically (see USB_VBUS_SENSING in usb_dc_stm32.c).
 *
 * USB's 48 MHz clock comes from the same PLL_Q=7 path whose baud-rate-style
 * symptoms were caused by the wrong &clk_hse frequency (see crazyflie21br.dts);
 * this overlay exists to test whether that fix also unblocks USB.
 *
 * Build:
 *   west build -p always -b crazyflie21br tapestry/tapestry-scr-hw -- \
 *     -DCONFIG_PWM=n \
 *     -DEXTRA_DTC_OVERLAY_FILE=boards/crazyflie21br_usb_console.overlay \
 *     -DCONFIG_USB_DEVICE_STACK_NEXT=y \
 *     -DCONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT=y \
 *     -DCONFIG_CDC_ACM_SERIAL_PRODUCT_STRING="\"Tapestry CF21 console\""
 *
 * Read:
 *   minicom -D /dev/ttyACM0   (CDC ACM is rate-less; any baud setting works)
 */

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};
