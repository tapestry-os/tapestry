# Kconfig — Crazyflie 2.1 brushless board module options
#
# Source from your application Kconfig (after "source Kconfig.zephyr"):
#   rsource "../tapestry-os/boards/crazyflie21bl/Kconfig"

choice CF21BL_ESC_PROTOCOL
	prompt "ESC signal protocol"
	depends on BOARD_CRAZYFLIE21BL
	default CF21BL_ESC_PWM400

config CF21BL_ESC_PWM400
	bool "RC PWM 400 Hz (1000-2000 us pulses)"
	help
	  Standard RC PWM.  Highest-latency option: up to 2.5 ms transport
	  delay against the 1 kHz control loop, which forces rate-loop gains
	  ~3x below the stock DSHOT-based firmware equivalents.

config CF21BL_ESC_ONESHOT125
	bool "OneShot125 (125-250 us pulses, 2 kHz frame rate)"
	help
	  OneShot125 through the same timer PWM path: 500 us frame period,
	  125 us = idle, 250 us = full.  ~5x lower transport delay than RC
	  PWM 400 Hz; cf21bl_stabilizer.c selects a higher rate-gain set to
	  match.  BLHeli_S auto-detects the input protocol at ESC power-on —
	  verify OneShot125 detection is not disabled in your BLHeli Suite
	  configuration (listen for the normal arming melody, then bench-test
	  throttle response with props off before flying).

endchoice

config CF21BL_STABILIZER
	bool "Cascaded attitude controller (rate loop + optional angle loop)"
	depends on BOARD_CRAZYFLIE21BL && FPU
	default n
	help
	  Enables cf21bl_stabilizer.c: a ~1 kHz PID stabilizer thread slaved to
	  the BMI088 INT3 data-ready interrupt.  substrate_move() becomes a
	  setpoint setter; the stabilizer drives motors independently.

	  Requires adding to CMakeLists.txt (inside if(CONFIG_PWM)):
	    if(CONFIG_CF21BL_STABILIZER)
	      target_sources(app PRIVATE
	        ${TAPESTRY_OS_BOARDS}/crazyflie21bl/cf21bl_stabilizer.c
	        ${TAPESTRY_OS_BOARDS}/crazyflie21bl/cf21bl_imu.c)
	    endif()

if CF21BL_STABILIZER

config CF21BL_ANGLE_MODE
	bool "Enable outer angle-error P loop (self-leveling)"
	default n
	help
	  Adds a P controller on roll/pitch angle error above the rate loop,
	  reading from the complementary filter (cf21bl_imu_filter_update).
	  substrate_move() angular.x/y become roll/pitch angle setpoints
	  (scaled to ±30 degrees) rather than rate setpoints.
	  angular.z remains a yaw rate setpoint in both modes.

config CF21BL_YAW_HOLD
	bool "Yaw heading hold (yaw attitude loop above the yaw rate loop)"
	depends on CF21BL_ANGLE_MODE
	default n
	help
	  Integrates angular.z yaw-rate commands into a heading target and
	  closes a PID around the Mahony yaw estimate, locking the heading
	  between commands instead of letting it random-walk with gyro noise
	  and residual bias.  Mirrors the stock firmware's yaw attitude PID
	  (Kp=6, Ki=1, Kd=0.35) above its yaw rate loop.  angular.z remains a
	  yaw-rate command; zero commanded rate now means "hold this heading".

config CF21BL_ALTITUDE_HOLD
	bool "Barometric altitude hold via BMP388"
	depends on BMP388
	default n
	help
	  Adds a Z-axis PID to the stabilizer thread driven by the BMP388
	  barometer (~50 Hz poll rate).  When enabled, linear.z in
	  substrate_move() is reinterpreted as an altitude setpoint:
	    linear.z < -0.9  → idle  (motors at minimum, PID inactive)
	    linear.z = -1..+1 → 0..2 m above the home altitude recorded at boot
	  Home altitude is the average of the first 50 BMP388 readings (~1 s).
	  Requires CONFIG_BMP388=y and bmp390@77 in crazyflie21bl.overlay.

config CF21BL_SP_STALE_MS
	int "Setpoint staleness timeout in milliseconds (0 = disabled)"
	default 500
	help
	  If no new setpoint is received for this many milliseconds while the
	  drone is airborne (linear.z > -0.9), the stabilizer levels out (zero
	  angular setpoints and lateral feedforward) and begins ramping the
	  collective (or altitude target) down, reaching idle at
	  CF21BL_SP_CUTOFF_MS — protecting against a radio link drop or
	  upper-layer hang while in flight.  Set to 0 to disable the watchdog
	  entirely.

config CF21BL_SP_CUTOFF_MS
	int "Setpoint staleness hard-cutoff in milliseconds"
	default 2000
	help
	  End of the stale-setpoint descent ramp: at this setpoint age the
	  collective reaches idle and the motors stop.  Between
	  CF21BL_SP_STALE_MS and this value the drone descends under control
	  (mirrors stock supervisor: 500 ms stabilize, 2 s shutdown).  Must be
	  greater than CF21BL_SP_STALE_MS; if not, the cut is immediate at
	  CF21BL_SP_STALE_MS.

endif # CF21BL_STABILIZER

config CF21BL_PM
	bool "Battery monitoring via nRF51 syslink"
	depends on BOARD_CRAZYFLIE21BL
	default n
	help
	  Enables cf21bl_pm.c: battery voltage telemetry from the nRF51 PM MCU
	  over the syslink UART (USART6), with low (3.35 V) and critical
	  (3.0 V) thresholds matching the stock firmware.  When the critical
	  threshold is sustained the stabilizer performs a controlled landing.

	  When CONFIG_TAPESTRY_TRANSCEIVER_SYSLINK is enabled, battery packets
	  are consumed from the transport subsystem's RX parser; otherwise this
	  module drives USART6 itself (requires CONFIG_UART_INTERRUPT_DRIVEN=y
	  plus CONFIG_SERIAL=y in the application conf).

	  Add to the application CMakeLists.txt:
	    if(CONFIG_CF21BL_PM)
	      target_sources(app PRIVATE
	        ${TAPESTRY_OS_BOARDS}/crazyflie21bl/cf21bl_pm.c)
	    endif()

if CF21BL_PM

config CF21BL_PM_COMPENSATE
	bool "Scale motor commands by VREF/vbat (thrust compensation)"
	depends on CF21BL_STABILIZER
	default y
	help
	  Multiplies the final per-motor commands by VREF/vbat (clamped to
	  [0.8, 1.3]) so delivered motor voltage — and thus thrust and loop
	  gain — stays approximately constant as the pack discharges.
	  First-order equivalent of the stock firmware's
	  CONFIG_ENABLE_THRUST_BAT_COMPENSATED.

config CF21BL_PM_VREF_MV
	int "Thrust-compensation reference voltage in millivolts"
	default 3700
	range 3000 4200
	help
	  The pack voltage at which CF21BL_HOVER_T and the PID gains were
	  tuned.  Motor commands are scaled by VREF/vbat, so at vbat == VREF
	  the compensation is exactly 1.0.  Set this to the loaded pack
	  voltage observed during your hover-throttle measurement.

endif # CF21BL_PM

config CF21BL_LIGHTHOUSE
	bool "Lighthouse v2 positioning (SteamVR 2.0)"
	depends on BOARD_CRAZYFLIE21BL && UART_INTERRUPT_DRIVEN
	default n
	help
	  Enables cf21bl_lighthouse.c: reads 12-byte UART frames from the
	  Lighthouse v2 deck FPGA and triangulates 3D position from two
	  SteamVR 2.0 base stations.

	  Hardware: deck FPGA streams frames over USART3 (PC10=TX, PC11=RX)
	  at 230400 baud.  Verified against Bitcraze crazyflie-firmware
	  src/drivers/interface/uart1.h and lighthouse_core.c.

	  CONSOLE CONFLICT: USART3 PC10/PC11 is also the Zephyr wired debug
	  console.  When the lighthouse deck is attached, the wired console
	  is unavailable.  Use the CRTP radio console (read_console.py via
	  crazyradio2) or USB CDC ACM instead.

	  Requires in application conf:
	    CONFIG_UART_INTERRUPT_DRIVEN=y

	  Add to CMakeLists.txt inside the if(CONFIG_PWM) block:
	    if(CONFIG_CF21BL_LIGHTHOUSE)
	      target_sources(app PRIVATE
	        ${TAPESTRY_OS_BOARDS}/crazyflie21bl/cf21bl_lighthouse.c)
	    endif()

	  The per-example boards/crazyflie21bl.overlay must set USART3 to
	  230400 baud and redirect the Zephyr console elsewhere:
	    &usart3 { current-speed = <230400>; };
	    / { chosen { zephyr,console = &usart2; }; };

	  Call cf21bl_lighthouse_set_bs_pose() for both base stations and
	  cf21bl_lighthouse_set_bs_channel() if your SteamVR room uses
	  non-default channel assignments before calling cf21bl_init().

	  Add to CMakeLists.txt inside the if(CONFIG_PWM) block:
	    if(CONFIG_CF21BL_LIGHTHOUSE)
	      target_sources(app PRIVATE
	        ${TAPESTRY_OS_BOARDS}/crazyflie21bl/cf21bl_lighthouse.c)
	    endif()

	  Call cf21bl_lighthouse_set_bs_pose() for both base stations
	  (ID 0 and 1) before enabling position hold.

if CF21BL_LIGHTHOUSE

config CF21BL_LIGHTHOUSE_POS_HOLD
	bool "XY position hold via Lighthouse (requires CF21BL_ANGLE_MODE)"
	depends on CF21BL_STABILIZER && CF21BL_ANGLE_MODE
	default n
	help
	  When the lighthouse has a valid fix, the stabilizer adds a
	  position PID loop: linear.x/y in substrate_move() become X/Y
	  position setpoints in metres relative to the lighthouse origin
	  (range ±CF21BL_POS_MAX_M, default ±5 m, mapped from [-1, +1]).

	  When the fix is lost, the stabilizer falls back to the standard
	  angle-mode behaviour (linear.x/y = velocity feedforward).

config CF21BL_POS_MAX_M
	int "Maximum XY position setpoint range in metres (half-range)"
	depends on CF21BL_LIGHTHOUSE_POS_HOLD
	default 5
	range 1 20
	help
	  linear.x/y = ±1.0 maps to ±CF21BL_POS_MAX_M metres from the
	  lighthouse origin.  Default 5 m gives a 10 m × 10 m arena.

endif # CF21BL_LIGHTHOUSE
