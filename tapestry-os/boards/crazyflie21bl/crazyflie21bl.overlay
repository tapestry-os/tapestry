/*
 * crazyflie21bl.overlay — Tapestry DTS overlay for Crazyflie 2.1 brushless
 *
 * Applied on top of tapestry-scr-hw/boards/bitcraze/crazyflie21bl/crazyflie21bl.dts.
 *
 * Hardware: STM32F405RGT6, 168 MHz, FPU
 * Motor ESC protocol: RC PWM at 400 Hz (2500 µs period)
 *   1000 µs = armed / idle
 *   2000 µs = full throttle
 *
 * Motor layout (from above):
 *   M4(CW)  M1(CCW)   ← front
 *   M3(CW)  M2(CCW)   ← back
 *
 * Pin assignments verified against CF2.1 brushless schematic Rev.G (2024-08-12):
 *   https://www.bitcraze.io/documentation/hardware/crazyflie_2_1_brushless/
 *
 * Motor → GPIO → TIM2 channel (from Bitcraze motorMapCF21Brushless in motors_def.c):
 *   M1 (front-right CCW) → PA1  → TIM2_CH2
 *   M2 (back-right  CCW) → PB11 → TIM2_CH4
 *   M3 (back-left   CW)  → PA15 → TIM2_CH1  (PA15 via JTAG-disable remap)
 *   M4 (front-left  CW)  → PB10 → TIM2_CH3
 *
 * ESC protocol: factory firmware uses DSHOT; RC PWM works if ESCs are
 * reconfigured via BLHeli Suite to standard PWM mode.
 *
 * nRF51 UART → USART6: PC6 = STM32 TX (NRF_RX net), PC7 = STM32 RX (NRF_TX net).
 * LED → PC1 (LED_GREEN_L), active-low (common-anode, STM32 sinks cathode).
 * ESC reset → PC15, open-drain active-low, shared across all four ESCs.
 *   STM32 reset leaves PC15 floating → ESCs held in reset.
 *   cf21bl_init() drives it HIGH (open-drain deassert) to release ESCs.
 *   Source: motors.c / hasPC15ESCReset in Bitcraze crazyflie-firmware.
 */

/ {
	aliases {
		cf21bl-motors = &cf21bl_motors;
	};

	cf21bl_motors: cf21-motors {
		compatible = "bitcraze,cf21-motors";
		/*
		 * Four ESC PWM channels in M1..M4 order.
		 * Period = 2 500 000 ns (400 Hz).  All channels on TIM2.
		 * Channel numbers are 1-based (Zephyr STM32 PWM driver convention).
		 */
		pwms = <&pwm2 2 2500000 PWM_POLARITY_NORMAL>,  /* M1 front-right CCW  TIM2_CH2 PA1  */
		       <&pwm2 4 2500000 PWM_POLARITY_NORMAL>,  /* M2 back-right  CCW  TIM2_CH4 PB11 */
		       <&pwm2 1 2500000 PWM_POLARITY_NORMAL>,  /* M3 back-left   CW   TIM2_CH1 PA15 */
		       <&pwm2 3 2500000 PWM_POLARITY_NORMAL>;  /* M4 front-left  CW   TIM2_CH3 PB10 */
	};
};

&timers2 {
	status = "okay";

	pwm2: pwm {
		status = "okay";
		pinctrl-0 = <
			&tim2_ch1_pa15   /* M3 back-left   — PA15 via JTAG-disable remap (CF21BL firmware motorMapCF21Brushless) */
			&tim2_ch2_pa1    /* M1 front-right — PA1  (CF21BL firmware motorMapCF21Brushless) */
			&tim2_ch3_pb10   /* M4 front-left  — PB10 (CF21BL firmware motorMapCF21Brushless) */
			&tim2_ch4_pb11   /* M2 back-right  — PB11 (CF21BL firmware motorMapCF21Brushless) */
		>;
		pinctrl-names = "default";
	};
};

/*
 * nRF51822 BLE radio co-processor — USART6 PC6/PC7 verified Rev.G.
 *
 * Net names from STM32 perspective: PC6 drives NRF_RX (nRF51 receive),
 * PC7 receives NRF_TX (nRF51 transmit).  Maps to USART6_TX/RX (AF8).
 *
 * PREREQUISITE to enable BLE: reflash nRF51 with HCI firmware (Nordic
 * hci_uart sample or Zephyr hci_uart app), then uncomment CONFIG_BT
 * block in tapestry-scr-hw/boards/crazyflie21bl.conf.
 */
&usart6 {
	status = "okay";
};

/*
 * BMI088 IMU (gyro + accel) on I2C3 — pin assignments confirmed against this
 * brushless board's actual schematic (2026-06-11), which differs from the
 * stock CF2.1 SPI wiring originally assumed (that schematic's PB13/14/15
 * are NRF_SWCLK / STM debug pins on this board, not BMI088 SPI):
 *   I2C3: SCL=PA8 (IMU_SCL), SDA=PC9 (IMU_SDA)
 *   CSB1/CSB2 (accel/gyro chip-select) not connected — relies on BMI088
 *   internal pull-up to default to I2C mode.
 *   Gyro INT3 (data-ready, ~1 kHz) = PC14, Accel INT1 = PC13 (not yet wired).
 *
 * I2C addresses: SDO1 (accel address pin) tied to GND -> accel addr 0x18.
 * Gyro confirmed at 0x69 (SDO2 pulled high on this board, opposite of the
 * accel's SDO1=GND), not the BMI088 default 0x68.
 *
 * accel-fs: this chip is a BMI088 (not BMI085) — the in-tree bmi08x driver's
 * BMI088 range table only has {3,6,12,24} g.  Requesting 8 would silently
 * select the ±12g hardware range while computing the conversion scale for
 * ±8g (a 1.5x error in every accel reading).  Use 12 directly so the
 * configured range and the scale factor agree (closest available to the
 * nominal ±8g starting point).
 *
 * gyro-hz "1000_116" = BW 116 Hz / ODR 1000 Hz, matching stock firmware and
 * giving the ~1 kHz INT3 data-ready interrupt the stabilizer loop is slaved
 * to.  accel-hz "1600" and accel-fs <24> match CF21BL stock firmware
 * (BMI088_ACCEL_ODR_1600_HZ, SENSORS_BMI088_ACCEL_CFG=24).  1600 Hz ODR
 * ensures a fresh accel sample is available every 1 kHz loop iteration.
 * 24 G range matches stock; 12 G gave better resolution but risked saturation
 * during aggressive maneuvers.
 */
&i2c3 {
	pinctrl-0 = <&i2c3_scl_pa8 &i2c3_sda_pc9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	status = "okay";

	bmi088_accel: bmi088-accel@18 {
		compatible = "bosch,bmi08x-accel";
		reg = <0x18>;
		accel-hz = "1600";
		accel-fs = <24>;
	};

	bmi088_gyro: bmi088-gyro@69 {
		compatible = "bosch,bmi08x-gyro";
		reg = <0x69>;
		int-gpios = <&gpioc 14 GPIO_ACTIVE_HIGH>;
		/* INT3 = data-ready, active-high push-pull */
		int3-4-map-io = <0x01>;
		int3-4-conf-io = <0x01>;
		gyro-fs = <2000>;
		gyro-hz = "1000_116";
	};
};
